[Unit]
Description=Cyberdyne Skynet - retint new app icons when an app is installed (event-driven)

[Path]
# v1.0.45: event-driven alternative to the weekly timer. The kernel
# watches these directories with inotify (zero daemon footprint, no
# polling); creating/removing/renaming a .desktop file here means an
# app was installed/removed/updated. The weekly timer stays as a
# safety net for icon-pack changes that don't touch these dirs.
PathChanged=%h/.local/share/applications
PathChanged=/usr/share/applications
PathChanged=/usr/local/share/applications
PathChanged=/var/lib/flatpak/exports/share/applications
PathChanged=%h/.local/share/flatpak/exports/share/applications

[Install]
WantedBy=default.target
